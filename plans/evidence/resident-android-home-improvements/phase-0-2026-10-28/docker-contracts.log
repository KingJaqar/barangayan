 CREATE OR REPLACE FUNCTION public.track_service_request_status()                          +
  RETURNS trigger                                                                          +
  LANGUAGE plpgsql                                                                         +
 AS $function$\r                                                                           +
 declare\r                                                                                 +
   v_note text;\r                                                                          +
 begin\r                                                                                   +
   if tg_op = 'INSERT' then\r                                                              +
     new.status_history := jsonb_build_array(\r                                            +
       jsonb_build_object('status', new.status, 'at', now(), 'note', 'Request submitted')\r+
     );\r                                                                                  +
   elsif tg_op = 'UPDATE' and new.status is distinct from old.status then\r                +
     v_note := nullif(current_setting('barangayan.status_note', true), '');\r              +
     new.status_history := old.status_history || jsonb_build_object(\r                     +
       'status', new.status, 'at', now(), 'note', v_note\r                                 +
     );\r                                                                                  +
   end if;\r                                                                               +
   return new;\r                                                                           +
 end;\r                                                                                    +
 $function$                                                                                +
 
