      "definition": "CREATE OR REPLACE FUNCTION public.current_barangay_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  select barangay_id from public.profiles where id = auth.uid();\r\n$function$\n",
      "security_definer": true
