    },
    {
      "name": "profiles_font_preference_check",
      "table": "profiles",
      "definition": "CHECK ((font_preference = ANY (ARRAY['system'::text, 'inter'::text, 'arial'::text, 'helvetica'::text, 'segoe-ui'::text, 'verdana'::text, 'tahoma'::text, 'trebuchet-ms'::text, 'georgia'::text, 'times-new-roman'::text, 'garamond'::text, 'courier-new'::text])))"
    },
    {
      "name": "profiles_id_fkey",
