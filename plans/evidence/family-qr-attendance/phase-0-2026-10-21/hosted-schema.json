      "definition": "CHECK ((id_verification_status = ANY (ARRAY['pending'::text, 'verified'::text, 'verification_failed'::text])))"
    },
    {
      "name": "profiles_pkey",
      "table": "profiles",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "profiles_role_check",
