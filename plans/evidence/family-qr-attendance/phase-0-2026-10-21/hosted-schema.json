    },
    {
      "name": "profiles_sex_check",
      "table": "profiles",
      "definition": "CHECK ((sex = ANY (ARRAY['male'::text, 'female'::text])))"
    },
    {
      "name": "profiles_theme_preference_check",
      "table": "profiles",
      "definition": "CHECK ((theme_preference = ANY (ARRAY['light'::text, 'dark'::text, 'system'::text])))"
    },
    {
      "name": "evacuation_centers_availability_check",
      "table": "evacuation_centers",
      "definition": "CHECK ((availability = ANY (ARRAY['available'::text, 'unknown'::text, 'unavailable'::text])))"
    },
    {
      "name": "evacuation_centers_barangay_id_fkey",
      "table": "evacuation_centers",
      "definition": "FOREIGN KEY (barangay_id) REFERENCES barangays(id) ON DELETE CASCADE"
    },
    {
      "name": "evacuation_centers_entrance_position_check",
      "table": "evacuation_centers",
      "definition": "CHECK (((entrance_position IS NULL) OR ((jsonb_typeof(entrance_position) = 'object'::text) AND (jsonb_typeof((entrance_position -> 'lat'::text)) = 'number'::text) AND (jsonb_typeof((entrance_position -> 'lng'::text)) = 'number'::text) AND\nCASE\n    WHEN ((jsonb_typeof((entrance_position -> 'lat'::text)) = 'number'::text) AND (jsonb_typeof((entrance_position -> 'lng'::text)) = 'number'::text)) THEN (((((entrance_position ->> 'lat'::text))::double precision >= ('-90'::integer)::double precision) AND (((entrance_position ->> 'lat'::text))::double precision <= (90)::double precision)) AND ((((entrance_position ->> 'lng'::text))::double precision >= ('-180'::integer)::double precision) AND (((entrance_position ->> 'lng'::text))::double precision <= (180)::double precision)))\n    ELSE false\nEND)))"
    },
    {
      "name": "evacuation_centers_pkey",
      "table": "evacuation_centers",
      "definition": "PRIMARY KEY (id)"
    },
    {
