+.popover { position: absolute; top: calc(100% + 7px); display: flex; flex-direction: column; width: 100%; min-width: 0; max-height: min(680px, calc(100dvh - 170px)); overflow: hidden; padding: 5px; }
 .popoverHeading { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; font-size: 13px; }
 .suggestions { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--search-border) transparent; }
 .popoverHeading button, .popoverStatus button, .popoverStatus a { color: var(--search-ink); font-size: 12px; font-weight: 600; }
-.suggestion { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 12px; font-size: 13px; }
-.suggestion:hover, .suggestion[aria-selected="true"] { background: var(--search-tint); }
+.suggestion { display: flex; min-height: 44px; align-items: center; gap: 10px; padding: 10px; border-radius: 7px; font-size: 13px; color: var(--dd-text); }
+.suggestion:hover { background: var(--dd-hover); }
+.suggestion[aria-selected="true"] { background: var(--dd-tint); outline: 1px solid var(--dd-border); outline-offset: -1px; }
 .suggestionContent { width: 100%; min-width: 0; }
 .suggestionContent > small { display: block; font-size: 10px; color: var(--search-muted); margin-bottom: 6px; }
 .hit { display: flex; align-items: center; gap: 12px; }
