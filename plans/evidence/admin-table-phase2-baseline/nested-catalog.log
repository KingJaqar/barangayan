}, {"data_type": "uuid", "table_name": "request_attachments", "column_name": "barangay_id", "is_nullable": "NO", "column_default": null}, {"data_type": "text", "table_name": "request_attachments", "column_name": "requirement_code", "is_nullable": "NO", "column_default": null}, {"data_type": "text", "table_name": "request_attachments", "column_name": "object_path", "is_nullable": "NO", "column_default": null}, {"data_type": "text", "table_name": "request_attachments", "column_name": "mime_type", "is_nullable": "NO", "column_default": null}, {"data_type": "integer", "table_name": "request_attachments", "column_name": "size_bytes", "is_nullable": "NO", "column_default": null}, {"data_type": "timestamp with time zone", "table_name": "request_attachments", "column_name": "created_at", "is_nullable": "NO", "column_default": "clock_timestamp()"}], "policies": [{"cmd": "INSERT", "qual": null, "roles": ["authenticated"], "tablename": "objects", "policyname": "residents upload own id docs", "schemaname": "storage", "with_check": "((bucket_id = 'id-documents'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))"}, {"cmd": "SELECT", "qual": "((bucket_id = 'id-documents'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))", "roles": ["authenticated"], "tablename": "objects", "policyname": "residents read own id docs", "schemaname": "storage", "with_check": null}, {"cmd": "SELECT", "qual": "((bucket_id = 'id-documents'::text) AND (\"current_role\"() = 'admin'::text) AND (EXISTS ( SELECT 1\n   FROM service_requests sr\n  WHERE ((sr.id_document_path = objects.name) AND (sr.barangay_id = current_barangay_id())))))", "roles": ["authenticated"], "tablename": "objects", "policyname": "admins read barangay id docs", "schemaname": "storage", "with_check": null}, {"cmd": "INSERT", "qual": null, "roles": ["authenticated"], "tablename": "objects", "policyname": "residents upload incident photos", "schemaname": "storage", "with_check": "((bucket_id = 'incident-photos