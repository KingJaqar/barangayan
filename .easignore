# EAS Build archive rules. When this file exists EAS ignores every .gitignore,
# so it repeats the root .gitignore and adds local-only tool/worktree/document folders.

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Supabase env files for apps/mobile (real values) — examples stay committed
.env
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
.next-*/

# --- local-only folders hidden by .git/info/exclude or tooling ---
# No trailing slash: eas-cli checks `ignores('.git')`, which `.git/` doesn't match, so
# the shallow clone's .git (~270 MB of packed history) would ship in the archive.
.git
.claude/
.kilo/
.kilocode/
.aider*
.aider-desk/
.scratch/
.vscode/
tmp/
**/.next/
**/.vercel/
**/.turbo/
**/node_modules/
**/.expo/
**/android/
**/ios/
design references/
barangayan project paper/
plans/
*.log
*.docx
*.pdf

# Recordings, reference docs and repomix dumps (screen records alone is ~920 MB).
# Keep data/: the mobile app bundles data/routing-packs.
screen records/
repomix output files/
repomix-output.xml
contexts/
/design/
output/
supabase/.temp/
*.mp4
*.MP4
*.mov
*.MOV
