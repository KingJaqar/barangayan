# Copy this file to .env.local and fill in the real values from your Supabase project
# (Dashboard → Settings → API). .env.local is gitignored; this .example file is not.
#
# NEXT_PUBLIC_* values are safe to ship to the browser — the anon key is meant
# to be public and is only as powerful as your RLS policies allow.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. It must NEVER have the
# NEXT_PUBLIC_ prefix (that would ship it to every visitor's browser) and is
# only read server-side — in Route Handlers and the paymongo-webhook Edge
# Function, never in a Client Component.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>
