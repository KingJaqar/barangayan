{
  "expo": {
    "name": "barangayan",
    "slug": "barangayan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/barangayan-logo-1024.png",
    "scheme": "barangayan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo/barangayan-logo-1024.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to scan barangay QR codes for evacuation check-in."
      }
    },
    "android": {
      "icon": "./assets/logo/barangayan-logo-1024.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/logo/barangayan-logo-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F6E5B",
          "image": "./assets/logo/barangayan-logo-1024.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
