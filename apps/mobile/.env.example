# Copy this file to .env and fill in the real values from your Supabase project
# (Dashboard → Settings → API). .env is gitignored; this .example file is not.
#
# Both values here are safe to ship in the mobile bundle — the anon key is
# meant to be public and is only as powerful as your RLS policies allow.
# Never put the service_role key in this file.

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# QR Ph goes live only once a settlement bank account is registered in the PayMongo
# dashboard (see the plan's Part G). Until then, leave this unset/false — the mobile
# Payment screen keeps QR Ph visible but gated behind a "Setup in Progress" notice and
# routes everyone to Cash on Delivery instead.
EXPO_PUBLIC_QRPH_SETTLEMENT_READY=false

# Public key only — safe to ship in the bundle. The secret key lives in Supabase Edge
# Function secrets, never here.
EXPO_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_live_GcifoVHXoizbYAqWEPmrPEeE
