# Copy this file to .env.local and fill in the real values from your Supabase project
# (Dashboard → Settings → API). .env.local is gitignored; this .example file is not.
#
# NEXT_PUBLIC_* values are safe to ship to the browser — the anon key is meant
# to be public and is only as powerful as your RLS policies allow.
#
# This app deliberately never carries SUPABASE_SERVICE_ROLE_KEY (see the plan's §7/§8
# Security Verification Track / Environment Contract) — every resident-web operation goes
# through the resident's own authenticated client + RLS, or a narrowly-scoped Server
# Action that still operates within the caller's own auth context.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Cross-origin bounce target used when an admin session lands on resident-web
# (lib/auth/require-user.ts) and when the admin-web login page needs to send a resident
# session here post-Phase-9. In local dev, admin-web runs on :3000 and resident-web on
# :3001 — this must point at admin-web's origin, not resident-web's own.
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3001

# Gates whether QR PH is offered as a real, chargeable payment option (Phase 3).
# Defaults to false — mirrors the mobile app's equivalent settlement-ready flag.
NEXT_PUBLIC_QRPH_SETTLEMENT_READY=false

# Optional: PayMongo's publishable/public key, only needed if a client-side PayMongo
# element/widget is ever added directly. Not currently read anywhere in this app's code
# (payment intents go through the create-payment-source/check-payment-status/
# cancel-payment edge functions server-side, C-031-C-033) — leave unset unless a future
# change actually consumes it.
# NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=<your-paymongo-public-key>
