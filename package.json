{
  "name": "barangayan",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@barangayan/mobile",
    "android": "npm run android --workspace=@barangayan/mobile",
    "ios": "npm run ios --workspace=@barangayan/mobile",
    "mobile:web": "npm run web --workspace=@barangayan/mobile",
    "mobile": "npm run start --workspace=@barangayan/mobile",
    "web": "npm run dev --workspace=@barangayan/web",
    "lint": "expo lint"
  }
}
